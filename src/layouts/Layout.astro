---
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX } from '../server-constants.ts'
import { getDatabase } from '../lib/notion/client.ts'
import { getNavLink, getStaticFilePath, filePath } from '../lib/blog-helpers.ts'
import '../styles/syntax-coloring.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import Darkmode from '../components/Darkmode.astro'
import SearchModal from '../components/SearchModal.astro'
import SearchButton from '../components/SearchButton.astro'

export interface Props {
  title: string
  description: string
  path: string
  ogImage: string
}

const { title = '', description = '', path = '/', ogImage = '' } = Astro.props

const database = await getDatabase()

const siteTitle = title ? `${title} - ${database.Title}` : database.Title
const siteDescription = description ? description : database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/default-og-image.png'),
  Astro.site
)

let coverImageURL: string
if (database.Cover) {
  if (database.Cover.Type === 'external') {
    coverImageURL = database.Cover.Url
  } else if (database.Cover.Type === 'file') {
    try {
      coverImageURL = filePath(new URL(database.Cover.Url))
    } catch (err) {
      console.log('Invalid DB cover image URL')
    }
  }
}

let customIconURL: string
if (database.Icon && database.Icon.Type === 'file') {
  try {
    customIconURL = filePath(new URL(database.Icon.Url))
  } catch (err) {
    console.log('Invalid DB custom icon URL')
  }
}
---

<!DOCTYPE html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large" />
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteURL} />
    <meta property="og:url" content={siteURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={database.Title} />
    <meta property="og:image" content={ogImage || siteOGImage} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage || siteOGImage} />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/png" href="favicon.png">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <meta name="google-site-verification" content="TUVhzTJvPtRImy_1HR0-cXqtymuqvACn-pS9DoNRiA4" />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />

    <!-- Sticky top navigation bar -->
    <nav class="site-topbar">
      <a href={getNavLink('/')} class="topbar-logo">
        {
          database.Icon && database.Icon.Type === 'emoji' ? (
            <span class="logo-icon">{database.Icon.Emoji}</span>
          ) : database.Icon && database.Icon.Type === 'external' ? (
            <img src={database.Icon.Url} alt="Site icon" class="logo-img" />
          ) : database.Icon && database.Icon.Type === 'file' ? (
            <img src={customIconURL} alt="Site icon" class="logo-img custom-icon" />
          ) : null
        }
        <span class="logo-text">{database.Title}</span>
      </a>
      <div class="topbar-controls">
        <SearchButton />
        <Darkmode />
      </div>
    </nav>

    <div class="container">
      <div class="content-wrap">
        <main>
          {
            coverImageURL && (
              <div class="cover">
                <img src={coverImageURL} alt="Site cover image" loading="lazy" />
              </div>
            )
          }
          <div class="content">
            <slot name="main" />
            <footer>
              <div>
                <span>Powered by&nbsp;</span>
                <a href="https://github.com/otoyo/astro-notion-blog">astro-notion-blog</a>
              </div>
            </footer>
          </div>
        </main>

        <aside>
          {database.Description && (
            <p class="site-description">{database.Description}</p>
          )}
          <div class="social-icons">
            <a href="/" aria-label="Home" title="Home">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15" fill="currentColor"><path d="M2 13.748c0 .138.112.25.25.25h3.749v-3h3v3h3.749a.25.25 0 0 0 .25-.25v-5.75H2zm11.93-7.17l-.932-.82V2a1 1 0 1 0-2 0v2L7.681 1.09a.25.25 0 0 0-.353-.011l-.011.011l-6.25 5.463a.25.25 0 0 0 .18.42L3 7h10.747a.25.25 0 0 0 .183-.421"/></svg>
            </a>
            <a href="https://www.youtube.com/@excelosarukun" aria-label="YouTube" title="YouTube" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://twitter.com/Excel_Osarukun" aria-label="X (Twitter)" title="X (Twitter)" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07l-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/></svg>
            </a>
            <a href="https://www.instagram.com/excel_osarukun/" aria-label="Instagram" title="Instagram" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          </div>
          <slot name="aside" />
        </aside>
      </div>
    </div>

    <SearchModal />
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
  </body>
</html>

<style>
  /* ===== Top navigation bar ===== */
  .site-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    background: rgba(250, 250, 250, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .topbar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .topbar-logo:hover { opacity: 0.75; }

  .logo-icon {
    font-size: 1.2rem;
    line-height: 1;
  }
  .logo-img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    border-radius: 4px;
  }
  .logo-img.custom-icon {
    border-radius: 6px;
  }
  .logo-text {
    max-width: 280px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .logo-text { max-width: 160px; }
  }

  .topbar-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ===== Main layout ===== */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    min-height: calc(100vh - 56px);
  }

  .content-wrap {
    display: flex;
    width: 100%;
  }
  @media (max-width: 768px) {
    .content-wrap {
      flex-direction: column;
    }
  }

  main {
    flex: 1;
    order: 1;
    min-width: 0;
  }

  aside {
    order: 2;
    width: 256px;
    flex-shrink: 0;
    padding: 32px 20px;
    border-left: 1px solid var(--border);
    position: sticky;
    top: 56px;
    height: calc(100vh - 56px);
    overflow-y: auto;
  }
  @media (max-width: 768px) {
    aside {
      order: 2;
      width: 100%;
      height: auto;
      position: static;
      border-left: none;
      border-top: 1px solid var(--border);
      padding: 20px 18px;
    }
  }

  .site-description {
    font-size: 0.82rem;
    color: var(--accents-3);
    line-height: 1.6;
    margin: 0 0 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  /* ===== Social icons ===== */
  .social-icons {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 0 0 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
  }
  .social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--accents-1);
    transition: background 0.15s, color 0.15s;
  }
  .social-icons a:hover {
    background: var(--border);
    color: var(--fg);
    opacity: 1;
  }
  .social-icons svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  /* ===== Cover image ===== */
  div.cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    object-position: center 60%;
  }

  /* ===== Main content area ===== */
  div.content {
    padding: 40px 48px;
    width: 100%;
    max-width: 60em;
    min-width: 0;
    margin-inline: auto;
  }
  @media (max-width: 768px) {
    div.content {
      padding: 24px 18px;
    }
  }

  main footer {
    margin: 56px 0 16px;
    text-align: center;
    font-size: 0.75rem;
    color: var(--accents-3);
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }
  main footer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<style is:global>
  :root {
    --gap-quarter: 0.25rem;
    --gap-half: 0.5rem;
    --gap: 1rem;
    --gap-double: 2rem;

    --bg: #F8F8F6;
    --fg: #111111;
    --accents-1: #333333;
    --accents-2: #555555;
    --accents-3: #999999;
    --geist-foreground: #000;
    --geist-success: #059669;

    --radius: 10px;
    --border: #E8E8E4;
    --card-bg: #ffffff;
    --shadow: 0 2px 8px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.04);
    --shadow-hover: 0 8px 24px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06);

    --font-sans: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: SFMono-Regular, Menlo, Consolas, 'PT Mono', 'Liberation Mono', Courier, monospace;
  }

  * {
    box-sizing: border-box;
    word-break: break-word;
  }

  html,
  body {
    padding: 0;
    margin: 0;
    font-size: 16px;
  }

  body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -webkit-text-size-adjust: 100%;
    line-height: 1.7;
  }

  figure {
    margin: 0;
    font-size: 0.85rem;
    color: var(--accents-3);
    line-height: 1.8rem;
  }

  a {
    color: var(--accents-1);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  a:hover {
    color: var(--accents-1);
    opacity: 0.75;
  }

  mark {
    padding: var(--gap-quarter);
    border-radius: 4px;
    background: rgba(247, 212, 255, 0.8);
  }

  h1 {
    margin: 0;
    color: var(--fg);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  @media (max-width: 768px) {
    h1 { font-size: 1.5rem; }
  }

  ol {
    color: var(--fg);
    font-weight: 400;
    font-size: 0.95rem;
    line-height: 1.9;
  }
  p, ul {
    color: var(--fg);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.9;
  }
  ul, ol {
    margin: 5px;
    padding-inline-start: 1.5rem;
  }

  pre {
    margin: 0;
    white-space: pre;
    tab-size: 2;
  }
  pre :global(code) {
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }

  hr {
    display: block;
    height: 1px;
    border: 0;
    margin: 0.3rem 0;
    background-color: var(--border);
  }

  code {
    font-size: 0.88rem;
    background: rgba(135, 131, 120, 0.15);
    color: #c0392b;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  table {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
    border-collapse: collapse;
  }
  table tr { vertical-align: top; }
  table th {
    font-weight: 700;
    background-color: #F3F4F6;
  }
  table td, table th {
    font-size: 0.9rem;
    border: 1px solid var(--border);
    padding: 0.5rem 1rem;
    text-align: left;
    line-height: 1.4;
  }
  table td::after {
    content: '';
    display: inline-block;
    min-height: 0.9rem;
  }

  /* ページトップに戻るボタン */
  .pagetop {
    height: 44px;
    width: 44px;
    position: fixed;
    right: 24px;
    bottom: 24px;
    background: var(--fg);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 50;
    box-shadow: var(--shadow);
    transition: opacity 0.2s, transform 0.2s;
  }
  .pagetop__arrow {
    height: 9px;
    width: 9px;
    border-top: 2px solid var(--bg);
    border-right: 2px solid var(--bg);
    transform: translateY(20%) rotate(-45deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .pagetop:hover {
      opacity: 0.8;
      transform: translateY(-2px);
    }
  }

  /* ===== Dark mode overrides ===== */
  .darkmode .site-topbar {
    background: rgba(25, 25, 25, 0.92);
    border-bottom-color: #2a2a2a;
  }
  .darkmode .topbar-logo {
    color: #e5e5e5 !important;
  }
</style>

---
import { Post } from '../lib/interfaces.ts'
import { getPostLink } from '../lib/blog-helpers.ts'
import NoContents from './NoContents.astro'

export interface Props {
  heading: string
  posts: Post[]
  accentColor?: string
  icon?: string
}

const { heading, posts, accentColor = '#6366f1', icon = '' } = Astro.props
---

<div class="section">
  <div class="section-header" style={`--accent: ${accentColor}`}>
    {icon && <span class="section-icon">{icon}</span>}
    <h2 class="section-title">{heading}</h2>
  </div>
  {
    posts.length === 0 ? (
      <NoContents contents={posts} />
    ) : (
      <ol class="section-list">
        {posts.map((post: Post, i: number) => (
          <li class="section-item">
            <span class="item-num" style={`color: ${accentColor}`}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <a
              href={getPostLink(post.Slug)}
              class="item-link"
              title={`${post.Icon?.Emoji || ''}${post.Title}`}
            >
              {post.Icon?.Type === 'emoji' && (
                <span class="item-emoji">{post.Icon.Emoji}</span>
              )}
              {post.Title}
            </a>
          </li>
        ))}
      </ol>
    )
  }
</div>

<style>
  .section {
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }
  .section:last-child {
    border-bottom: none;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
  }

  .section-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  .section-title {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    position: relative;
    padding-left: 10px;
  }
  .section-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 12px;
    background: var(--accent);
    border-radius: 2px;
  }

  .section-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .section-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 4px 0;
  }

  .item-num {
    font-size: 0.65rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    flex-shrink: 0;
    min-width: 18px;
    opacity: 0.8;
  }

  .item-link {
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--accents-2);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: color 0.15s;
    flex: 1;
    min-width: 0;
  }
  .item-link:hover {
    color: var(--fg);
    opacity: 1;
  }

  .item-emoji {
    margin-right: 0.2em;
    font-size: 0.9em;
  }
</style>

---
import { Post } from '../lib/interfaces.ts'
import { getPostLink } from '../lib/blog-helpers.ts'
import NoContents from './NoContents.astro'

export interface Props {
  heading: string
  posts: Post[]
}

const { heading, posts } = Astro.props
---

<div class="blog-posts-link">
  <h2>{heading}</h2>
  {
    posts.length === 0 ? (
      <NoContents contents={posts} />
    ) : (
      <ul>
        {posts.map((post: Post) => (
          <li>
            <a
              href={getPostLink(post.Slug)}
              title={`${post.Icon?.Emoji || ''}${post.Title}`}
            >
              {post.Icon && post.Icon.Type === 'emoji' ? (
                <>
                  <span>{post.Icon.Emoji}</span>
                  {post.Title}
                </>
              ) : post.Icon && post.Icon.Type === 'external' ? (
                <>
                  <img
                    src={post.Icon.Url}
                    alt="Post title icon in a link list"
                  />
                  {post.Title}
                </>
              ) : (
                post.Title
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .blog-posts-link {
    margin-bottom: 1.5rem;
  }
  .blog-posts-link h2 {
    margin: 0 0 0.6rem;
    color: var(--accents-3);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .blog-posts-link ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }
  .blog-posts-link ul li {
    border-radius: var(--radius);
  }
  .blog-posts-link ul li a {
    display: block;
    padding: 6px 8px;
    border-radius: 6px;
    line-height: 1.4;
    color: var(--fg);
    font-size: 0.85rem;
    font-weight: 400;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: background 0.15s;
  }
  .blog-posts-link ul li a:hover {
    background: #F3F4F6;
    opacity: 1;
  }
  .blog-posts-link ul li a span,
  .blog-posts-link ul li a img {
    display: inline-block;
    margin-right: 0.3rem;
  }
  .blog-posts-link ul li a img {
    width: 1.1rem;
    height: 1.1rem;
    vertical-align: sub;
  }
</style>

---
import * as interfaces from '../lib/interfaces.ts'
import { buildHeadingId } from '../lib/blog-helpers.ts'

export interface Props {
  blocks: interfaces.Block[]
}

const { blocks } = Astro.props

type TocItem = {
  id: string
  text: string
  level: 1 | 2 | 3
}

const toc: TocItem[] = blocks
  .filter(b => b.Type === 'heading_1' || b.Type === 'heading_2' || b.Type === 'heading_3')
  .map(b => {
    const heading = b.Heading1 || b.Heading2 || b.Heading3
    if (!heading) return null
    const id = buildHeadingId(heading)
    const text = heading.RichTexts.map(rt => rt.Text?.Content || '').join('').trim()
    if (!text) return null
    const level = b.Type === 'heading_1' ? 1 : b.Type === 'heading_2' ? 2 : 3
    return { id, text, level } as TocItem
  })
  .filter((item): item is TocItem => item !== null)
---

{toc.length > 0 && (
  <nav class="toc" aria-label="目次">
    <h2 class="toc-heading">目次</h2>
    <ul class="toc-list">
      {toc.map(item => (
        <li class={`toc-item toc-level-${item.level}`}>
          <a href={`#${item.id}`} class="toc-link" data-toc-id={item.id}>
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link')
  if (links.length > 0) {
    const ids = Array.from(links).map(l => l.dataset.tocId).filter(Boolean) as string[]

    const setActive = (id: string) => {
      links.forEach(l => {
        if (l.dataset.tocId === id) {
          l.classList.add('toc-link--active')
        } else {
          l.classList.remove('toc-link--active')
        }
      })
    }

    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id)
            break
          }
        }
      },
      { rootMargin: '-10% 0px -80% 0px', threshold: 0 }
    )

    ids.forEach(id => {
      const el = document.getElementById(id)
      if (el) observer.observe(el)
    })

    // Click smooth scroll
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const id = link.dataset.tocId
        if (!id) return
        const el = document.getElementById(id)
        if (el) {
          const topOffset = 72
          const top = el.getBoundingClientRect().top + window.scrollY - topOffset
          window.scrollTo({ top, behavior: 'smooth' })
        }
      })
    })
  }
</script>

<style>
  .toc {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .toc-heading {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 10px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: 0.02em;
  }
  .toc-heading::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 14px;
    background: #f59e0b;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-item {
    line-height: 1.3;
  }
  .toc-level-2 {
    padding-left: 12px;
  }
  .toc-level-3 {
    padding-left: 24px;
  }
  .toc-link {
    display: block;
    padding: 4px 6px;
    border-radius: 5px;
    font-size: 0.8rem;
    color: var(--accents-2);
    border-left: 2px solid transparent;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .toc-link:hover {
    color: var(--fg);
    background: var(--border);
    opacity: 1;
  }
  .toc-link--active {
    color: var(--fg);
    font-weight: 500;
    border-left-color: var(--fg);
    background: rgba(0,0,0,0.04);
  }
</style>

---
import * as interfaces from '../lib/interfaces.ts'
import { buildHeadingId } from '../lib/blog-helpers.ts'

export interface Props {
  blocks: interfaces.Block[]
}

const { blocks } = Astro.props

type TocItem = {
  id: string
  text: string
  level: 1 | 2 | 3
}

const toc: TocItem[] = blocks
  .filter(b => b.Type === 'heading_1' || b.Type === 'heading_2' || b.Type === 'heading_3')
  .map(b => {
    const heading = b.Heading1 || b.Heading2 || b.Heading3
    if (!heading) return null
    const id = buildHeadingId(heading)
    const text = heading.RichTexts.map(rt => rt.Text?.Content || '').join('').trim()
    if (!text) return null
    const level = b.Type === 'heading_1' ? 1 : b.Type === 'heading_2' ? 2 : 3
    return { id, text, level } as TocItem
  })
  .filter((item): item is TocItem => item !== null)
---

{toc.length > 0 && (
  <nav class="toc" aria-label="目次">
    <div class="toc-header">
      <span class="toc-icon">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="3" width="7" height="1.5" rx="0.75" fill="currentColor"/>
          <rect x="2" y="7" width="12" height="1.5" rx="0.75" fill="currentColor"/>
          <rect x="2" y="11" width="9" height="1.5" rx="0.75" fill="currentColor"/>
        </svg>
      </span>
      <h2 class="toc-title">目次</h2>
    </div>
    <div class="toc-track">
      <div class="toc-indicator" id="toc-indicator"></div>
      <ul class="toc-list">
        {toc.map((item, idx) => (
          <li
            class={`toc-item toc-level-${item.level}`}
            data-toc-index={idx}
          >
            <a
              href={`#${item.id}`}
              class="toc-link"
              data-toc-id={item.id}
            >
              <span class="toc-dot"></span>
              <span class="toc-text">{item.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link')
  const indicator = document.getElementById('toc-indicator')

  if (tocLinks.length > 0) {
    let activeIndex = -1

    const updateActive = (id: string) => {
      tocLinks.forEach((link, i) => {
        const isActive = link.dataset.tocId === id
        link.classList.toggle('toc-link--active', isActive)
        link.closest('li')?.classList.toggle('toc-item--active', isActive)

        if (isActive && indicator) {
          const li = link.closest('li') as HTMLElement
          if (li) {
            indicator.style.top = `${li.offsetTop + li.offsetHeight / 2 - 6}px`
            indicator.style.opacity = '1'
          }
        }
      })
    }

    const ids = Array.from(tocLinks)
      .map(l => l.dataset.tocId)
      .filter(Boolean) as string[]

    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            updateActive(entry.target.id)
            break
          }
        }
      },
      { rootMargin: '-8% 0px -82% 0px', threshold: 0 }
    )

    ids.forEach(id => {
      const el = document.getElementById(id)
      if (el) observer.observe(el)
    })

    // Smooth scroll on click
    tocLinks.forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault()
        const id = link.dataset.tocId
        if (!id) return
        const el = document.getElementById(id)
        if (el) {
          // <a id="..."> はインライン要素なので getBoundingClientRect が不安定
          // 子のブロック要素（h1-h4）を直接ターゲットにして精度を上げる
          const blockEl = (el.querySelector('h1,h2,h3,h4') as HTMLElement) || el
          const topbar = document.querySelector('.site-topbar') as HTMLElement
          const offset = (topbar?.offsetHeight ?? 56) + 16
          const top = blockEl.getBoundingClientRect().top + window.scrollY - offset
          window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' })
          updateActive(id)
        }
      })
    })
  }
</script>

<style>
  .toc {
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 14px;
  }

  .toc-icon {
    display: flex;
    align-items: center;
    color: var(--accents-3);
  }
  .toc-icon svg {
    width: 14px;
    height: 14px;
  }

  .toc-title {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accents-3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .toc-track {
    position: relative;
    padding-left: 16px;
    border-left: 1px solid var(--border);
  }

  .toc-indicator {
    position: absolute;
    left: -5px;
    top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--fg);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--fg);
    transition: top 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s;
    opacity: 0;
    pointer-events: none;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .toc-item {
    transition: padding 0.15s;
  }
  .toc-level-2 { padding-left: 10px; }
  .toc-level-3 { padding-left: 20px; }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 4px;
    border-radius: 5px;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--accents-2);
    transition: color 0.15s, background 0.15s;
    text-decoration: none;
  }
  .toc-link:hover {
    color: var(--fg);
    background: rgba(128,128,128,0.08);
    opacity: 1;
  }

  .toc-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
    opacity: 0.35;
    transition: opacity 0.15s, transform 0.15s;
  }

  .toc-text {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .toc-link--active {
    color: var(--fg) !important;
    font-weight: 600;
  }
  .toc-link--active .toc-dot {
    opacity: 1;
    transform: scale(1.6);
  }
</style>

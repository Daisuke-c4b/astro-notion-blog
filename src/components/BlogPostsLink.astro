---
import { Post } from '../lib/interfaces.ts'
import { getPostLink } from '../lib/blog-helpers.ts'
import NoContents from './NoContents.astro'

export interface Props {
  heading: string
  posts: Post[]
  accentColor?: string
}

const { heading, posts, accentColor = '#6366f1' } = Astro.props
---

<div class="blog-posts-link">
  <h2 class="section-heading" style={`--accent: ${accentColor}`}>{heading}</h2>
  {
    posts.length === 0 ? (
      <NoContents contents={posts} />
    ) : (
      <ul>
        {posts.map((post: Post) => (
          <li>
            <a
              href={getPostLink(post.Slug)}
              title={`${post.Icon?.Emoji || ''}${post.Title}`}
            >
              {post.Icon && post.Icon.Type === 'emoji' ? (
                <>
                  <span>{post.Icon.Emoji}</span>
                  {post.Title}
                </>
              ) : post.Icon && post.Icon.Type === 'external' ? (
                <>
                  <img src={post.Icon.Url} alt="Post title icon in a link list" />
                  {post.Title}
                </>
              ) : (
                post.Title
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .blog-posts-link {
    margin-bottom: 24px;
  }
  .section-heading {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 8px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: 0.02em;
  }
  .section-heading::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 14px;
    background: var(--accent);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .blog-posts-link ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }
  .blog-posts-link ul li a {
    display: block;
    padding: 5px 8px;
    border-radius: 6px;
    line-height: 1.4;
    color: var(--accents-2);
    font-size: 0.82rem;
    font-weight: 400;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: background 0.15s, color 0.15s;
  }
  .blog-posts-link ul li a:hover {
    background: var(--border);
    color: var(--fg);
    opacity: 1;
  }
  .blog-posts-link ul li a span,
  .blog-posts-link ul li a img {
    display: inline-block;
    margin-right: 0.3rem;
  }
  .blog-posts-link ul li a img {
    width: 1rem;
    height: 1rem;
    vertical-align: sub;
  }
</style>

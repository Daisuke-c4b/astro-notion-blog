---
import { Post } from '../lib/interfaces.ts'
import { getDateStr } from '../lib/blog-helpers.ts'

export interface Props {
  post: Post
}

const { post } = Astro.props
---

<div class="post-date">
  <!-- {post.Date ? getDateStr(post.Date) : ''} -->
  {post.Date ? <span>投稿日：{getDateStr(post.Date)}</span> : ''}
</div>

<style>
  .post-date {
    padding: 0;
    font-size: 0.8rem;
    color: var(--accents-3);
    font-weight: 400;
  }
</style>

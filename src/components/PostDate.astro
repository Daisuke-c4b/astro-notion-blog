---
import { Post } from '../lib/interfaces.ts'
import { getDateStr } from '../lib/blog-helpers.ts'

export interface Props {
  post: Post
}

const { post } = Astro.props
---

<div class="post-date">
  {post.Date && (
    <>
      <svg class="cal-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="1" y="3" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.25"/>
        <path d="M1 7h14" stroke="currentColor" stroke-width="1.25"/>
        <path d="M5 1v4M11 1v4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
      </svg>
      <span>{getDateStr(post.Date)}</span>
    </>
  )}
</div>

<style>
  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--accents-3);
    font-weight: 400;
  }
  .cal-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    position: relative;
    top: -0.5px;
  }
</style>

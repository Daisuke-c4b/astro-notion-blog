---
import { Post } from '../lib/interfaces.ts'
import { getDateStr } from '../lib/blog-helpers.ts'

export interface Props {
  post: Post
}

const { post } = Astro.props
---

{post.UpdateDate && (
  <span class="update-date">· {getDateStr(post.UpdateDate)} 更新</span>
)}

<style>
  .update-date {
    font-size: 0.78rem;
    color: var(--accents-3);
    font-weight: 400;
  }
</style>
